    "mobile:ios": "next build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/ios": "8.5.0",
    "@capacitor/splash-screen": "8.0.0",
    "@capacitor/status-bar": "8.0.0",
    "@trotebox/contracts": "0.3.9",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
