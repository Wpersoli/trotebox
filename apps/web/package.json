{
  "name": "@trotebox/web",
  "version": "0.3.9",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
