# Shared
NODE_ENV=development
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,capacitor://localhost,https://localhost,http://localhost
JWT_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-a-distinct-32-character-secret
HASH_PEPPER=replace-with-another-distinct-32-character-secret
ENABLE_DEV_AUTH=true
AUTH_DELIVERY=console
AUTH_CODE_PEPPER=replace-with-a-distinct-32-character-secret
AUTH_CODE_TTL_MINUTES=7
RESEND_API_KEY=
EMAIL_FROM=TroteBox <acesso@seudominio.com>

# PostgreSQL (use pooled connection in Vercel/serverless)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trotebox?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/trotebox?schema=public

# Telephony: mock | twilio | vonage
TELEPHONY_PROVIDER=mock
MOCK_CALL_AUTO_COMPLETE=true
VOICE_ENGINE=provider
CUSTOM_TTS_URL=
CUSTOM_TTS_API_KEY=
CUSTOM_TTS_ALLOWED_HOSTS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VALIDATE_SIGNATURES=true
VONAGE_APPLICATION_ID=
VONAGE_API_KEY=
VONAGE_PRIVATE_KEY=
VONAGE_FROM_NUMBER=
VONAGE_SIGNATURE_SECRET=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PACK_STARTER=
STRIPE_PRICE_PACK_PLUS=
STRIPE_PRICE_PACK_PRO=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Operations
CRON_SECRET=replace-me
RECORDING_ENABLED=false
RECORDING_RETENTION_DAYS=30
MAX_CALLS_PER_USER_PER_HOUR=5
MAX_CALLS_PER_RECIPIENT_PER_DAY=2

# Frontend public values only
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_TIMEOUT_MS=10000
NEXT_PUBLIC_CLIENT_PLATFORM=web
NEXT_PUBLIC_PREVIEW_MODE=false
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true
NEXT_PUBLIC_AUTH_MODE=passwordless
NEXT_PUBLIC_APP_NAME=TroteBox
NEXT_PUBLIC_COMMERCE_MODE=web
